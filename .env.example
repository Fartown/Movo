# Copy to .env and fill in the API key before building.
# Literal single-line values; optional single/double quotes, no variable expansion.
# Environment variables override these values in CI.
# These defaults are included in the APK and can be extracted from it.
ETA_DEFAULT_PROVIDER_NAME=Ark DeepSeek
ETA_DEFAULT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ETA_DEFAULT_API_KEY=
ETA_DEFAULT_MODEL_ID=deepseek-v4-1-flash-260910
ETA_DEFAULT_MODEL_NAME=DeepSeek-v4.1-Flash
ETA_DEFAULT_ENDPOINT_MODE=responses
ETA_DEFAULT_CONTEXT_WINDOW=1048576
ETA_DEFAULT_HOSTED_WEB_SEARCH=true
