<?xml version="1.0" encoding="utf-8"?>
<!--
   备份与换机迁移规则（Android 12+）。完整运行日志（files/run-log）只留在本机：
   不进云备份，也不随换机迁移带到新手机。其余数据保持系统默认。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="run-log/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="run-log/" />
    </device-transfer>
</data-extraction-rules>
